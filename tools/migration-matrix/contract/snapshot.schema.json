{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Migration Matrix snapshot contract v1.x (1.1 adds data.weekly and the project table fields)",
  "description": "The payload push_snapshot.py POSTs to /api/migration/ingest. Additive-tolerant: unknown top-level keys are allowed (minor version bumps). The server's hand-rolled guards (snapshotProblems in routes/migration.ts and its api/index.ts twin) enforce the same required set.",
  "type": "object",
  "required": [
    "contract",
    "generated_at",
    "source",
    "source_files",
    "data",
    "facts",
    "findings"
  ],
  "properties": {
    "contract": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "generated_at": {
      "type": "string"
    },
    "source": {
      "enum": [
        "mac-agent",
        "github-action",
        "graph",
        "manual"
      ]
    },
    "source_files": {
      "type": "object",
      "required": [
        "tracker",
        "matrices"
      ],
      "properties": {
        "tracker": {
          "$ref": "#/definitions/filemeta"
        },
        "matrices": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/filemeta"
          }
        }
      }
    },
    "week": {
      "type": "string"
    },
    "week_lbl": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "clients",
        "team",
        "overview"
      ],
      "properties": {
        "clients": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "total",
              "done",
              "remaining"
            ],
            "properties": {
              "assigned": {
                "type": "number",
                "description": "1.1: pages assigned so far (tracker)"
              },
              "left": {
                "type": "number",
                "description": "1.1: total minus done, never negative"
              },
              "min_per_page": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "1.1: build minutes per page from the tracker"
              },
              "qa_min_per_page": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "hours_to_finish": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "1.1: (left pages at min_per_page) + (QA left at qa_min_per_page); null when no rate"
              },
              "rate_set": {
                "type": "boolean"
              },
              "qa_done": {
                "type": "number"
              },
              "priority": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "start_date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mig_deadline": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "team": {
          "type": "array"
        },
        "overview": {
          "type": "object"
        },
        "weekly": {
          "type": "object",
          "description": "1.1: per-person, per-week pages assigned (tracker) vs done (client matrix where one exists, else the tracker's Pages Completed).",
          "required": [
            "weeks",
            "labels",
            "current",
            "people"
          ],
          "properties": {
            "weeks": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "current": {
              "type": "string"
            },
            "people": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "weeks"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "role": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "avail": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  },
                  "weeks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "week",
                        "assigned",
                        "done"
                      ],
                      "properties": {
                        "week": {
                          "type": "string"
                        },
                        "assigned": {
                          "type": "number"
                        },
                        "hours": {
                          "type": "number"
                        },
                        "done": {
                          "type": "number"
                        },
                        "projects": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "project",
                              "assigned",
                              "done",
                              "done_source"
                            ],
                            "properties": {
                              "project": {
                                "type": "string"
                              },
                              "assigned": {
                                "type": "number"
                              },
                              "hours": {
                                "type": "number"
                              },
                              "done": {
                                "type": "number"
                              },
                              "done_source": {
                                "enum": [
                                  "matrix",
                                  "tracker"
                                ]
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "unmatched": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "initials",
                  "role",
                  "project",
                  "pages"
                ]
              }
            },
            "initials": {
              "type": "object"
            }
          }
        }
      }
    },
    "facts": {
      "type": "object"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "code",
          "message"
        ],
        "properties": {
          "severity": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "location": {
            "type": "string"
          }
        }
      }
    }
  },
  "definitions": {
    "filemeta": {
      "type": "object",
      "required": [
        "name",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mtime": {
          "type": "string"
        },
        "web_url": {
          "type": "string"
        }
      }
    }
  }
}
